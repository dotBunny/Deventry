<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Deventry.App.ViewModels"
             xmlns:conversation="using:Deventry.App.Conversation"
             x:Class="Deventry.App.Views.ProjectActionEditorView"
             x:DataType="vm:ProjectActionEditorViewModel">
  <!-- A custom project action (DESIGN.md §18, "Custom actions"), over Settings' Actions page -->
  <Border Classes="dialog" Width="460">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
      <TextBlock Text="Name" />
      <TextBox Text="{Binding Name}" PlaceholderText="for example: Run the game's tests" AutomationProperties.Name="Name" />
      <TextBlock Text="Command" Margin="0,4,0,0" />
      <TextBox Classes="mono" Text="{Binding Command}" PlaceholderText="{Binding CommandPlaceholder}" AutomationProperties.Name="Command" />
      <TextBlock Classes="muted small" Text="{Binding ShellText}" TextWrapping="Wrap" />
      <TextBlock Text="Working folder" Margin="0,4,0,0" />
      <TextBox Classes="mono" Text="{Binding WorkingFolder}" PlaceholderText="The tab's folder" AutomationProperties.Name="Working folder" />
      <TextBlock Classes="muted small" Text="{Binding Folder, StringFormat='Relative to {0}'}" TextWrapping="Wrap" />
      <TextBlock Text="Only show when this exists" Margin="0,4,0,0" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Classes="mono" Text="{Binding IfExists}" PlaceholderText="Always shown" AutomationProperties.Name="Only show when this exists" />
        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseIfExistsCommand}" />
      </Grid>
      <TextBlock Classes="muted small" TextWrapping="Wrap"
                 Text="A file or folder, relative to the same folder, such as the build the action runs. Separate several with semicolons." />
      <!-- Where it shows in the project's menu, and with what (DESIGN.md §18, "Project tools") -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,4,0,0">
        <TextBlock Text="Group" />
        <TextBlock Grid.Column="1" Text="Icon" />
        <AutoCompleteBox Grid.Row="1" ItemsSource="{Binding Groups}" Text="{Binding Group}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                         PlaceholderText="None" AutomationProperties.Name="Group" />
        <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding IconChoices}" SelectedItem="{Binding SelectedIcon}"
                  AutomationProperties.Name="Icon">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:MenuIconChoice">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="menuicon" Width="14" Height="14" Data="{Binding IconKey, Converter={x:Static conversation:ToolIcons.Geometry}}" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
      <TextBlock Classes="muted small" TextWrapping="Wrap"
                 Text="Actions in the same group share a section, under its name, in the project menu's Actions." />
      <RadioButton GroupName="ProjectActionMode" Content="Run with output" IsChecked="{Binding RunWithOutput}" Margin="0,4,0,0" />
      <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-6,0,0"
                 Text="Its run shows under the tab in the sidebar, with its log and Stop, and a notification says when it ends." />
      <RadioButton GroupName="ProjectActionMode" Content="Launch and forget" IsChecked="{Binding LaunchAndForget}" />
      <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-6,0,0"
                 Text="For programs that keep running on their own, such as an editor or a server." />
      <!-- DESIGN.md §18, "Setting up a new worktree" -->
      <CheckBox Content="Also run it in each new worktree a worktree tab makes" IsChecked="{Binding RunOnNewWorktree}" Margin="0,4,0,0" />
      <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="28,-6,0,0" Text="{Binding RunOnNewWorktreeText}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
