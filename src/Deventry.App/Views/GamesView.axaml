<!-- Games with Joulene (DESIGN.md §18): the Games tool window, the same game whichever tab has the focus; the game
     to play is chosen in the window's header (ToolPanelView). Made only while it shows. Its look is in
     Themes/ConversationStyles.axaml. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Deventry.App.ViewModels"
             xmlns:services="using:Deventry.App.Services"
             xmlns:games="using:Deventry.App.Games"
             xmlns:views="using:Deventry.App.Views"
             x:Class="Deventry.App.Views.GamesView"
             x:DataType="services:GameService"
             Focusable="True">
  <Panel>
  <!-- With no game open, the games to start one, each with its score so far (DESIGN.md §18, "Games with Joulene") -->
  <ScrollViewer x:Name="GameChoices" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsChoosing}">
    <StackPanel Classes="gameheader" Spacing="8">
      <TextBlock Text="Play a game against Joulene" FontWeight="SemiBold" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Choices}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="services:GameChoice">
            <Button Classes="flat row gamechoice" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Command="{Binding Start}" CommandParameter="{Binding Kind}" AutomationProperties.Name="{Binding AccessibleName}">
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" />
                <TextBlock Classes="muted small" Text="{Binding ScoreText}" IsVisible="{Binding HasScore}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
  <DockPanel IsVisible="{Binding IsOpen}">
    <StackPanel DockPanel.Dock="Top" Classes="gameheader">
      <!-- A tab waits on the user: the game stays as it is -->
      <Border Classes="codeblock" IsVisible="{Binding HasCall}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Classes="warning" Text="{Binding Call}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Go there" Command="{Binding AnswerCallCommand}" IsVisible="{Binding CanAnswerCall}" />
        </Grid>
      </Border>
      <!-- Whose move it is, or how the round ended, and how well she plays -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding Game.Status, FallbackValue={x:Null}}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Game.Levels, FallbackValue={x:Null}}" SelectedItem="{Binding Game.Level, FallbackValue={x:Null}}"
                  IsVisible="{Binding Game.HasLevels, FallbackValue=False}" AutomationProperties.Name="Level" ToolTip.Tip="How well Joulene plays" />
      </Grid>
    </StackPanel>

    <!-- The board, then the score, a new round and the end of the game under it -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <ContentControl Content="{Binding Game}">
          <ContentControl.DataTemplates>
            <!-- Tic-tac-toe: three by three on one board, the user ✕ and Joulene ○. An empty square under the pointer shows a
                 faint ✕ while it's the user's move, and the three in a row that win are struck through. -->
            <DataTemplate DataType="vm:TicTacToeViewModel">
              <StackPanel Classes="gameboard">
                <Border Classes="gamesurface">
                  <Panel>
                    <ItemsControl ItemsSource="{Binding Squares}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="3" Rows="3" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:TicTacToeSquare">
                          <Button Classes="boardcell gamesquare" Classes.winning="{Binding IsWinning}" Command="{Binding PlayCommand}"
                                  AutomationProperties.Name="{Binding Name}">
                            <Border Classes="slot">
                              <Panel>
                                <Path Classes="gamex" Data="{StaticResource IconClose}" IsVisible="{Binding IsYours}" />
                                <Ellipse Classes="gameo" IsVisible="{Binding IsHers}" />
                                <Path Classes="gamex ghost" Data="{StaticResource IconClose}" IsVisible="{Binding CanPlay}" />
                              </Panel>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <views:GameStrike Classes="strike" Columns="3" Rows="3" From="{Binding StrikeFrom}" To="{Binding StrikeTo}" />
                  </Panel>
                </Border>
              </StackPanel>
            </DataTemplate>

            <!-- Four in a Row: seven columns of six holes in one board. A column is a button that drops a piece in it; under
                 the pointer it lights up and shows where the user's piece would land. The last piece dropped has a dot. -->
            <DataTemplate DataType="vm:FourInARowViewModel">
              <StackPanel Classes="gameboard">
                <Border Classes="gamesurface">
                  <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:FourInARowColumn">
                        <Button Classes="boardcell gamecolumn" Command="{Binding DropCommand}" AutomationProperties.Name="{Binding Name}">
                          <Border Classes="lane">
                            <ItemsControl ItemsSource="{Binding Cells}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:FourInARowCell">
                                  <Panel>
                                    <Ellipse Classes="gamepiece" Classes.yours="{Binding IsYours}" Classes.hers="{Binding IsHers}"
                                             Classes.winning="{Binding IsWinning}" Classes.drop="{Binding IsDropSpot}" />
                                    <Ellipse Classes="lastdot" IsVisible="{Binding IsLast}" />
                                  </Panel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </DataTemplate>

            <!-- Hangman: the gallows and what she said about the word, the word a letter at a time on its lines, and the
                 letters as keys on a board, which sink once guessed -->
            <DataTemplate DataType="vm:HangmanViewModel">
              <StackPanel Classes="gameboard">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Canvas Width="80" Height="108" AutomationProperties.Name="{Binding FigureName}">
                    <Line Classes="gallows" StartPoint="4,104" EndPoint="66,104" />
                    <Line Classes="gallows" StartPoint="18,104" EndPoint="18,6" />
                    <Line Classes="gallows" StartPoint="18,6" EndPoint="58,6" />
                    <Line Classes="gallows" StartPoint="18,24" EndPoint="36,6" />
                    <Line Classes="gallows" StartPoint="58,6" EndPoint="58,18" />
                    <Ellipse Classes="hanged" Canvas.Left="49" Canvas.Top="18" Width="18" Height="18" IsVisible="{Binding ShowsHead}" />
                    <Line Classes="hanged" StartPoint="58,36" EndPoint="58,64" IsVisible="{Binding ShowsBody}" />
                    <Line Classes="hanged" StartPoint="58,43" EndPoint="47,56" IsVisible="{Binding ShowsLeftArm}" />
                    <Line Classes="hanged" StartPoint="58,43" EndPoint="69,56" IsVisible="{Binding ShowsRightArm}" />
                    <Line Classes="hanged" StartPoint="58,64" EndPoint="49,82" IsVisible="{Binding ShowsLeftLeg}" />
                    <Line Classes="hanged" StartPoint="58,64" EndPoint="67,82" IsVisible="{Binding ShowsRightLeg}" />
                  </Canvas>
                  <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding Hint}" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                </Grid>
                <ItemsControl Classes="hangmanword" ItemsSource="{Binding Slots}" AutomationProperties.Name="{Binding PatternName}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="4" LineSpacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:HangmanSlot">
                      <Border Classes="wordslot" Classes.missed="{Binding Missed}">
                        <TextBlock Text="{Binding Letter}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="gamesurface">
                  <ItemsControl ItemsSource="{Binding Letters}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:HangmanLetter">
                        <Button Classes="boardcell gameletter" Classes.guessed="{Binding IsGuessed}" Classes.found="{Binding IsFound}"
                                Classes.missed="{Binding IsMissed}" Command="{Binding GuessCommand}" AutomationProperties.Name="{Binding Name}">
                          <Border Classes="key">
                            <TextBlock Text="{Binding Text}" />
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </DataTemplate>

            <!-- Minesweeper: nine by nine on one board, the squares still shut raised off it and those open sunk into it; a
                 click opens a square, a right-click or F flags it (GamesView.axaml.cs). Tab goes into the field once, and the
                 arrow keys move between its squares. -->
            <DataTemplate DataType="vm:MinesweeperViewModel">
              <StackPanel Classes="gameboard">
                <Border Classes="gamesurface">
                  <ItemsControl ItemsSource="{Binding Squares}" AutomationProperties.Name="Minefield"
                                XYFocus.NavigationModes="Keyboard" KeyboardNavigation.TabNavigation="Once">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="{x:Static games:Minesweeper.Columns}" Rows="{x:Static games:Minesweeper.Rows}" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:MinesweeperSquare">
                        <Button Classes="boardcell minesquare" Classes.open="{Binding IsOpen}" Classes.exploded="{Binding IsExploded}"
                                Classes.n1="{Binding Text, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}"
                                Classes.n2="{Binding Text, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}"
                                Classes.n3="{Binding Text, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=3}"
                                Classes.n4="{Binding Text, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=4}"
                                Classes.n5="{Binding Text, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=5}"
                                Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                          <Border Classes="minecell">
                            <Panel>
                              <TextBlock Text="{Binding Text}" />
                              <Path Classes="mineflag" Data="{StaticResource IconMarkFlag}" IsVisible="{Binding ShowsFlag}" />
                              <Path Classes="minewrong" Data="{StaticResource IconClose}" IsVisible="{Binding IsWrongFlag}" />
                              <Ellipse Classes="mine" IsVisible="{Binding ShowsMine}" />
                            </Panel>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </DataTemplate>

            <!-- Pipeline: the pieces to come and the hurry over eight by eight under her tap; a click lays the next piece.
                 Tab goes into the board once, and the arrow keys move between its squares. -->
            <DataTemplate DataType="vm:PipelineViewModel">
              <StackPanel Classes="gameboard">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <ItemsControl ItemsSource="{Binding Next}" VerticalAlignment="Center" AutomationProperties.Name="{Binding NextName}"
                                ToolTip.Tip="The pieces to come: a click lays the first">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:PipePiece">
                        <Border Classes="pipepiece" Classes.next="{Binding IsNext}">
                          <views:PipeTile Classes="pipe" ShowsSlot="False" Piece="{Binding Piece}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Grid.Column="2" Content="{Binding HurryText}" Command="{Binding HurryCommand}" IsVisible="{Binding CanHurry}"
                          ToolTip.Tip="{Binding HurryTip}" VerticalAlignment="Center" />
                </Grid>
                <!-- The squares touch, so pipes side by side join; under the pointer, one shows the piece a click would lay -->
                <Border Classes="gamesurface pipeboard">
                  <ItemsControl ItemsSource="{Binding Squares}" AutomationProperties.Name="Pipeline"
                                XYFocus.NavigationModes="Keyboard" KeyboardNavigation.TabNavigation="Once">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="{x:Static games:Pipeline.Columns}" Rows="{x:Static games:Pipeline.Rows}" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:PipeSquare">
                        <Button Classes="boardcell pipesquare" Command="{Binding LayCommand}" AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Tip}">
                          <views:PipeTile Classes="pipe" Piece="{Binding Piece}" Opening="{Binding Opening}" Flows="{Binding Flows}" Spill="{Binding Spill}"
                                          Countdown="{Binding Countdown}"
                                          Ghost="{Binding $parent[ItemsControl].((vm:PipelineViewModel)DataContext).Next[0].Piece, FallbackValue={x:Static games:PipeKind.Empty}}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        <StackPanel Classes="gamefooter">
          <TextBlock Classes="muted small" Text="{Binding Game.ScoreText, FallbackValue={x:Null}}" IsVisible="{Binding Game.HasScore, FallbackValue=False}" />
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
            <Button Content="{Binding Game.NewRoundText, FallbackValue={x:Null}}" Command="{Binding Game.NewRoundCommand, FallbackValue={x:Null}}" />
            <Button Grid.Column="1" Classes="flat" Content="Reset score" Command="{Binding Game.ResetScoreCommand, FallbackValue={x:Null}}"
                    IsVisible="{Binding Game.HasScore, FallbackValue=False}" ToolTip.Tip="Start this game's score again from nothing" />
            <Button Grid.Column="3" Classes="flat" Content="Done playing" Command="{Binding CloseCommand}" ToolTip.Tip="End the game, and go back to the list of games." />
          </Grid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
  </Panel>
</UserControl>
